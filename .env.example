# База данных (общая БД для всех юзеров)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=bot_postgres
DB_POSTGRESDB_PORT=port
DB_POSTGRESDB_DATABASE=name_of_your_database
DB_POSTGRESDB_USER=Username
DB_POSTGRESDB_PASSWORD=password
N8N_SECURE_COOKIE=false

# Telegram
TELEGRAM_BOT_TOKEN=1234567890:AAF1.....

# ИИ через OpenRouter (Для дешевых моделей, например gpt-4o-mini или llama-3-8b)
OPENROUTER_API_KEY=sk-or-v1-...

# Публичный URL туннеля
WEBHOOK_URL=https://effaceable-untediously-mee.ngrok-free.dev
N8N_HOST=effaceable-untediously-mee.ngrok-free.dev
